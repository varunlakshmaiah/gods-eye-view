# ============================================================================
# Gods-Eye-View Sidecar Configuration
# Copy this file to sidecar/.env.sidecar (gitignored)
# ============================================================================

# --- Networking & Upstream Target ---
UPSTREAM_URL=http://upstream:4173
PROXY_PORT=8080
MCP_GATEWAY_PORT=8000
MCP_GATEWAY_HOST=0.0.0.0

# --- Storage: Tile38 (Hot Tier) ---
TILE38_HOST=tile38
TILE38_PORT=9851
TILE38_TTL_SECONDS=120

# --- Storage: TimescaleDB (Cold Tier) ---
POSTGRES_DB=gods_eye_sidecar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@timescaledb:5432/gods_eye_sidecar

# --- Headless Keep-Alive Cron Intervals (Milliseconds / Seconds) ---
# Active only when 0 browser clients are connected
HEADLESS_ENABLED=true
HEADLESS_FLIGHTS_INTERVAL_MS=15000
HEADLESS_VESSELS_INTERVAL_MS=30000
HEADLESS_WEATHER_INTERVAL_MS=1800000
HEADLESS_FIRMS_INTERVAL_MS=1800000
HEADLESS_CELESTRAK_INTERVAL_MS=21600000

# --- Ingestion Batching ---
TIMESCALE_BATCH_FLUSH_INTERVAL_MS=2000
TIMESCALE_BATCH_MAX_SIZE=500

# --- WebSocket Co-Pilot ---
WS_COPILOT_PORT=8000
WS_COPILOT_PATH=/ws/copilot
